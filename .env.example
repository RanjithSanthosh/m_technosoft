# ==============================================================================
# Muruganantham Technosoft (MT) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before deploying to production.
# NEVER commit production API keys or credentials to public Git repositories.

# Canonical Production URL (Used for sitemap.xml, robots.txt, and canonical meta tags)
# Replace with your finalized domain upon purchase: e.g. https://mtechnosoft.com
SITE_URL=https://mtechnosoft.com

# Form Delivery Endpoint (Optional)
# If using Formspree, Resend, or a cloud serverless function, enter the endpoint below.
# Default static behavior: Falls back to an accessible pre-filled mailto bridge to mtechnosoft.dev@gmail.com
# Example: FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
FORMSPREE_ENDPOINT=

# Company Notification Email
NOTIFICATION_EMAIL=mtechnosoft.dev@gmail.com

# Direct WhatsApp Contact Number
WHATSAPP_PHONE=918778232067

# Port for local static preview server
PORT=3000
